    {
      "datasource": {
        "type": "prometheus",
        "uid": "svr-prometheus"
      },
      "description": "AI10 / NFR20 alert threshold: > 20% over 24 hours triggers supervisor alert.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "Human Review Rate 24h (Alert > 20%)",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "svr-prometheus" },
          "expr": "sum(increase(svr_human_review_tickets_total[24h])) / clamp_min(sum(increase(svr_pipeline_runs_total[24h])), 1)",
          "legendFormat": "Human Review Rate (24h)",
          "refId": "A"
        }
      ]
    },
