# SVR Production Environment Configuration
# Copy to .env and fill strong secrets before running in production.

SVR_ENV=development
SVR_ORG_NAME="Egypt Telecom Care"
SVR_ORG_SLUG="egypt-telecom-care"

# Production: postgresql+psycopg://svr:svr@postgres:5432/svr
# Local standalone fallback: sqlite:///E:/migration/Projects/SVR/storage/svr.db
DATABASE_URL=sqlite:///E:/migration/Projects/SVR/storage/svr.db

# Production: redis://redis:6379/0 (leave empty for in-process async worker)
REDIS_URL=

# Cryptographic keys (set strong values in production; never commit real keys)
SVR_SECRET_KEY=replace-with-32-byte-random-secret
SVR_ENCRYPTION_KEY=replace-with-url-safe-base64-fernet-key

# Storage and model directories
SVR_STORAGE_DIR=E:/migration/Projects/SVR/storage
SVR_MODELS_DIR=E:/migration/Projects/SVR/models/marbertv2-single-task
WHISPER_MODEL_ID=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# VoiceGate LangGraph + ONNX CPU Acceleration
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL_ID=qwen2.5:3b
AGENTIC_GATE_ENABLED=true
AGENTIC_GATE_FAST_PATH_ENABLED=true
SVR_MARBERT_BACKEND=auto
SVR_LOW_MEMORY_MODE=1
SVR_DOMAIN=localhost

# Cache paths (keep on E: drive to preserve C: space)
HF_HOME=E:/migration/Projects/SVR/.cache/huggingface
TORCH_HOME=E:/migration/Projects/SVR/.cache/torch

# FFmpeg tools
FFMPEG_BIN=E:/migration/Temp-Archive/ffmpeg/ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe
FFPROBE_BIN=E:/migration/Temp-Archive/ffmpeg/ffmpeg-9.0.2-essentials_build/bin/ffprobe.exe

# Bootstrap operator credentials (change immediately in production)
SVR_BOOTSTRAP_PASSWORD=SvrTelecom2026!
SVR_COOKIE_SECURE=false
SVR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
