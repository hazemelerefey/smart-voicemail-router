# SVR Production Environment Configuration
# Copy to .env and fill strong secrets before running in production.

SVR_ENV=development
SVR_ORG_NAME="Egypt Telecom Care"
SVR_ORG_SLUG="egypt-telecom-care"

# Production: postgresql+psycopg://svr:svr@postgres:5432/svr
# Local standalone fallback: sqlite:///./storage/svr.db
DATABASE_URL=sqlite:///./storage/svr.db

# Production: redis://redis:6379/0 (leave empty for in-process async worker)
REDIS_URL=
SVR_REDIS_QUEUE_KEY=svr:pipeline:queue
SVR_REDIS_INFLIGHT_KEY=svr:pipeline:inflight
SVR_REDIS_EVENTS_CHANNEL=svr:pipeline:events

# Cryptographic keys (set strong values in production; never commit real keys)
SVR_SECRET_KEY=replace-with-32-byte-random-secret
SVR_ENCRYPTION_KEY=replace-with-url-safe-base64-fernet-key

# Storage and model directories
SVR_STORAGE_DIR=./storage
SVR_MODELS_DIR=./models/marbertv2-single-task

# Transcription (STT) backend:
#   cohere_gpu_int8 (6 GB GPU default: NAMAA-Space/cohere-transcribe-arabic-07-2026-int8)
#   cohere_bf16     (8+ GB GPU: CohereLabs/cohere-transcribe-arabic-07-2026)
#   cohere_gguf     (CPU GGUF via transcribe-cli binary)
#   faster_whisper  (CPU fallback: Whisper large-v3 int8)
SVR_STT_BACKEND=faster_whisper
COHERE_MODEL_ID=NAMAA-Space/cohere-transcribe-arabic-07-2026-int8
COHERE_BF16_MODEL_ID=CohereLabs/cohere-transcribe-arabic-07-2026
SVR_COHERE_LOCAL_FILES_ONLY=true
SVR_COHERE_GGUF_BIN=
SVR_COHERE_GGUF_MODEL_PATH=
WHISPER_MODEL_ID=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# VoiceGate LangGraph + Cognitive Memory + ONNX CPU Acceleration
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL_ID=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3:latest
AGENTIC_GATE_ENABLED=true
AGENTIC_GATE_FAST_PATH_ENABLED=true
SVR_ADAPTIVE_REAUDIT_ENABLED=true
SVR_ADAPTIVE_REAUDIT_CATEGORY_THRESHOLD=0.60
SVR_ADJUDICATOR_ENABLED=true
SVR_ADJUDICATOR_CONF_TRIGGER=0.68
SVR_ADJUDICATOR_MARGIN_TRIGGER=0.25
SVR_ADJUDICATOR_KNN_K=7
SVR_MEMORY_ENABLED=true
SVR_MEMORY_TRAIN_SEED_CSV=
SVR_MARBERT_BACKEND=auto
SVR_ONNX_MAX_RESIDENT_HEADS=2
SVR_LOW_MEMORY_MODE=1
SVR_DOMAIN=localhost

# Cache paths (keep local to workspace or mount volume in Docker)
HF_HOME=./.cache/huggingface
TORCH_HOME=./.cache/torch

# FFmpeg tools (must be on PATH or overridden per host)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Bootstrap operator credentials (change immediately in production)
SVR_BOOTSTRAP_PASSWORD=SvrTelecom2026!
SVR_COOKIE_SECURE=false
SVR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
